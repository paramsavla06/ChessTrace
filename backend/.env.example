# ==============================================================================
# ChessTrace Environment Configuration
# ==============================================================================

# Database Connection URL
# ------------------------------------------------------------------------------
# Option A: Local SQLite (Default for quick testing)
DATABASE_URL=postgresql+psycopg2://<user>:<password>@<host>:<port>/<dbname>

# Option B: PostgreSQL (Default for production)
# DATABASE_URL=postgresql+psycopg2://postgres:your_password@localhost:5432/chesstrace

# Stockfish Engine Executable Path
# ------------------------------------------------------------------------------
# Windows example:
STOCKFISH_PATH=C:/stockfish/stockfish-windows-x86-64-avx2.exe

# Linux / Mac example:
# STOCKFISH_PATH=/usr/games/stockfish

# Application Settings
# ------------------------------------------------------------------------------
PROJECT_NAME=ChessTrace
API_V1_STR=/api/v1

# Lichess API Token (Optional, increases rate limits for game downloads)
# Generate a free token at https://lichess.org/account/oauth/token
# LICHESS_API_TOKEN=lip_xxxxxxxxx
