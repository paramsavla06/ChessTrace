# ==============================================================================
# ChessTrace Backend Environment Configuration
# ==============================================================================

# Database Connection URL (PostgreSQL / Neon / SQLite)
# ------------------------------------------------------------------------------
# PostgreSQL (Default / Production):
DATABASE_URL=postgresql://username:password@localhost:5432/chesstrace
# Or for Neon Serverless / Pooled connection:
# DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
# Or for quick local testing without PostgreSQL:
# DATABASE_URL=sqlite:///./chesstrace.db

# Stockfish Engine Executable Path
# ------------------------------------------------------------------------------
# Relative repository path or absolute path to the Stockfish binary:
STOCKFISH_PATH=backend/app/engine/stockfish.exe
# Linux / Docker / Render production example:
# STOCKFISH_PATH=/usr/games/stockfish

# Lichess API Token
# ------------------------------------------------------------------------------
# Personal access token to increase rate limits for game downloads and live streaming.
# Generate a free token at https://lichess.org/account/oauth/token
LICHESS_API_TOKEN=your_lichess_api_token_here

# Frontend / API URLs
# ------------------------------------------------------------------------------
# URL for the API endpoint used by the frontend client:
VITE_API_URL=https://chesstrace.onrender.com/api/v1
# Optional: Frontend URL for CORS configuration
# FRONTEND_URL=https://chess-trace.vercel.app
